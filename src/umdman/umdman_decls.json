 "types": {
  "SceAtaCmdState": "/* per-command completion state, lives on the caller's stack; ata->cmd points to it */\ntypedef struct {\n    u32 unk0;\n    u32 driveStat;\n    u32 unk8;\n    u32 unkC;\n} SceAtaCmdState;",
  "SceAtaDrive": "/* ata.prx drive descriptor (only the fields umdman touches) */\ntypedef struct {\n    s8 driveId;\n    u8 pad1[0x7];\n    u32 unk8;\n    u32 timeout;              /* 0x0C: per-command timeout, func_00005358 table */\n#if FW_VERSION == 100\n    u8 pad10[0x8];\n#else\n    u8 pad10[0x4];\n#endif\n    u32 byteLimit;            /* 0x18 (1.50: 0x14): sceAtaGetByteLimitCount() */\n    u8 pad1C[0x4];\n    SceAtaCmdState * volatile cmd; /* 0x20 (1.50: 0x1C): caller's stack state */\n} SceAtaDrive;",
  "SceUmdDrive": "/* 1.00: g_umdDrive[2], 0x40 bytes each */\ntypedef struct {\n    SceAtaDrive *ataDrive;\n    u8 pad4[0x14];\n    SceUID semaId;\n    u8 pad1C[0xC];\n    u8 sense[0x12];\n    u8 pad3A[0x6];\n} SceUmdDrive;",
  "SceUmdModeParam": "/* MODE SENSE/SELECT(10) parameters */\ntypedef struct {\n    u8 unk0;\n    u8 pageCode;\n    u8 pad2[2];\n    u16 size;\n    u8 pad6[0xA];\n} SceUmdModeParam;",
