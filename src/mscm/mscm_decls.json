 "types": {
  "SceMScmHC": "/* host controller state; drivers get a pointer to it as their HC descriptor */\ntypedef struct SceMScmHC {\n    SceMScmHCReg *reg;      /* 0x00 */\n    s32 index;              /* 0x04: slot / HC number */\n    struct SceMScmHC *hc;   /* 0x08: points to itself */\n    s32 inService;          /* 0x0C */\n#if FW_VERSION < 250\n    s32 unk10;\n    u32 intrStatus;         /* 0x14 */\n    s32 lastStatus;         /* 0x18 */\n    s32 unk1C;\n    s32 unk20[4];           /* 0x20: initialised to -1 */\n    SceUID evf;             /* 0x30: \"SceMScmAl\" */\n    u8 unk34[0x27C - 0x34];\n#if FW_VERSION >= 150\n    s32 unk27C;\n    s32 unk280;\n#endif\n#else\n    s32 unk10;\n    s32 lastStatus;         /* 0x14 */\n    s32 unk18;\n    s32 unk1C[4];\n    SceUID evf;             /* 0x2C */\n#endif\n} SceMScmHC;\n#if FW_VERSION < 150\ntypedef char chk_SceMScmHC[(sizeof(SceMScmHC) == 0x27C) ? 1 : -1];\n#elif FW_VERSION < 250\ntypedef char chk_SceMScmHC[(sizeof(SceMScmHC) == 0x284) ? 1 : -1];\n#endif",
  "SceMScmHCReg": "/* Memory Stick host controller (MSIF) registers, 0xBD200000 */\ntypedef struct {\n    u8 unk0[0x30];\n    volatile u16 command;   /* 0x30: TPC << 12 | size */\n    u16 unk32;\n    volatile u32 data;      /* 0x34 */\n    volatile u16 status;    /* 0x38 */\n    u16 unk3A;\n    volatile u16 sys;       /* 0x3C */\n    u16 unk3E;\n    volatile u32 unk40;     /* 0x40 */\n} SceMScmHCReg;"
 },
